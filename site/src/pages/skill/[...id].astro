---
import { getCollection, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { titleFrom, sourcePath } from '../../lib/titles.ts';

export async function getStaticPaths() {
  const entries = await getCollection('skills');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Doc
  title={titleFrom(headings, entry.id)}
  source={sourcePath(entry.filePath, `skills/${entry.id}.md`)}
  kind="the skill"
  body={(entry as typeof entry & { body?: string }).body}
  id={entry.id}
>
  <Content />
</Doc>
