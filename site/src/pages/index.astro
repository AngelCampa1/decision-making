---
import Base from '../layouts/Base.astro';
import RouterDemo from '../components/RouterDemo.svelte';
import { REPO } from '../lib/site.ts';
import { skillFacts, publishedRunCount, armResults, requireCopy } from '../lib/facts.ts';
import { verdictState } from '../lib/verdicts.ts';
import { shown } from '../lib/claims.ts';
import { SITE_DESCRIPTION, SKILL_DESCRIPTION } from '../lib/site.ts';
import {
  graph,
  personNode,
  softwareNode,
  webPageNode,
  websiteNode,
} from '../lib/schema.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const facts = await skillFacts();
const state = verdictState(facts.verdict);
const runs = await publishedRunCount();
const arms = await armResults('n7-remaining-arms');

/**
 * Plain-English copy for each procedure.
 *
 * Keyed by filename and joined to the derived list by `requireCopy`, which
 * refuses a partial join in either direction. This map cannot decide how many
 * procedures there are, and that is the whole arrangement: an array here is how
 * the page came to say four while the skill said six.
 */
const COPY: Record<string, { name: string; when: string; ask: string; after: string }> = {
  'ledger.md': {
    name: 'Sort the pile',
    when: 'Too much arrived and you cannot tell what matters.',
    ask: 'Here is the whole thread. What do I do about Tuesday?',
    after: `TURNS ON
  the Lisbon forecast
  the Tuesday flight

SET ASIDE
  the rain in Paraguay
  Your trip does not touch it.

SO
  pack for Lisbon`,
  },
  'fit.md': {
    name: 'Check it fits you',
    when: 'The advice is right in general and may be wrong for you.',
    ask: 'Everyone says save six months of pay before you quit. Should I?',
    after: `NORMAL ANSWER
  Save six months of pay first.

WHAT WOULD CHANGE IT
  Your visa is tied to your job.
  Then line up the next job first.

  Under about four months of savings,
  take the contract first.

SO
  Ask about the visa before anything else.`,
  },
  'cascade.md': {
    name: 'Follow what it starts',
    when: 'The move looks fine and the worry is what comes next.',
    ask: 'Should I resign?',
    after: `CHAIN
  Resigning gets you out.
  It also ends your standing.
  You can no longer raise the thing
  you were going to raise.

CLOSES
  the talk you were saving for later

SO
  That second part decides the answer.`,
  },
  'timing.md': {
    name: 'Now or later',
    when: 'You know what to do and not when.',
    ask: 'The offer says decide by Friday. Do I answer now?',
    after: `UNDO PRICE
  You can say no up to your start date.
  After that it costs a job and a reference.

REAL DEADLINE
  The letter has a written expiry.

FELT DEADLINE
  You want the worry to stop.

WAITING
  buys:  You hear from the other firm on Thursday.
  costs: The team starts planning without you.

SO
  Wait for Thursday. Answer Friday morning.`,
  },
  'council.md': {
    name: 'Hear both sides',
    when: 'Two answers are each fair and one got argued first.',
    ask: 'Do we sell the company, or keep building it?',
    after: `THE CASE FOR SELLING
  put at full strength

THE CASE FOR STAYING
  put at full strength

WHERE THEY SPLIT
  what you think the next
  two years look like

SO
  Answer that, and the choice
  follows from it.`,
  },
  'hinge.md': {
    name: 'Ask or decide',
    when: 'A fact is missing and you cannot tell if it matters.',
    ask: 'We never called her references. Do we make the offer?',
    after: `MISSING
  what her last manager would say

WOULD IT SWING IT
  Yes. Two people already raised
  the same worry.

SO
  Ask. This one is worth the wait.
  The rest of what you have is enough.`,
  },
};

const procedures = requireCopy(facts.procedures, COPY);

/** The counts in the hero. Two derived from the repository, two bound to a document. */
const counts = [
  { value: shown('total-model-calls'), label: 'model calls on record' },
  { value: String(runs), label: 'runs written up here' },
  { value: shown('broken-measurements'), label: 'of our own tests found broken' },
  { value: shown('word-trick-ceiling'), label: 'best score with no model at all' },
];

const testArms = [
  ['off', 'No skill at all.', 'the floor'],
  ['on', 'The real skill.', 'the thing we care about'],
  ['placebo', 'Filler of the same length and shape.', 'whether the words did the work'],
  ['cot', 'Just "think step by step".', 'whether a cheap line does the same'],
];

// The plot's scale. A zero floor would squeeze every arm into the top eighth of
// the frame and hide the only thing the chart is for; a floor at the lowest arm
// would exaggerate the gap. A round floor below the minimum, printed on the
// axis, is the honest middle.
/**
 * The social card understated the procedure count for five days after the skill
 * started routing to six, because it was a default parameter in a layout nobody
 * had reason to look at. It lives on the page it describes now.
 *
 * The count is not spelled out here on purpose. `site/claims.json` refuses any
 * page carrying a retracted phrase, and it cannot tell a published claim from a
 * comment describing one, so a comment that quoted the old wording would fail
 * the gate that exists to catch the old wording. Say what was wrong; do not
 * reprint it.
 *
 * Deliberately no measured numbers in any of these strings. They are cached by
 * every crawler that has ever seen the page and cannot be corrected once
 * posted, so they say only what is structurally true.
 */
const DESCRIPTION = `A free file your AI agent reads when you face a hard call. ${facts.countWord} methods, and it reads one. The evaluation harness that measures it is here too.`;
const OG_TITLE = 'An agent skill for hard choices, and the harness that measures it.';
const OG_DESCRIPTION = `${facts.countWord} procedures. Your agent reads one. Free, and one line installs it. Every result is public, including the ones that went badly.`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteRoot = new URL(`${base}/`, Astro.site).href;
const schema = graph([
  personNode(siteRoot),
  websiteNode(siteRoot, SITE_DESCRIPTION),
  softwareNode(siteRoot, SKILL_DESCRIPTION, facts.version),
  webPageNode(canonical, siteRoot, 'decision-making-skills', DESCRIPTION),
]);

const floor = 0.8;
const span = 1 - floor;
const place = (n: number) => ((n - floor) / span) * 100;
const best = Math.max(...arms.map((a) => a.accuracy));
---

<Base
  title="decision-making-skills: an agent skill, and the LLM evaluation harness that tests it"
  description={DESCRIPTION}
  ogTitle={OG_TITLE}
  ogDescription={OG_DESCRIPTION}
  schema={schema}
>
  <div class="page">
    <header class="board hero">
      <div class="hero__main">
        <p class="hero__meta">
          <span class="verdict" data-verdict={state}>{facts.verdict}</span>
          <span>v{facts.version}</span>
          <span>Apache-2.0</span>
        </p>

        <h1 class="hero__title">
          {facts.countWord} methods.<br /><span>Your agent reads one.</span>
        </h1>

        <p class="lede">
          A free file your AI agent reads when you face a hard call. It works out what is
          hard about the choice first. Then it runs one method for it, not all {
            facts.countWord.toLowerCase()
          }.
        </p>

        <div class="cta">
          <a class="cta__primary" href="#install">Install it</a>
          <a class="cta__secondary" href={`${base}/docs/status/`}>See what we found</a>
          <a class="cta__secondary" href={REPO}>Read the code</a>
        </div>
      </div>

      <dl class="hero__counts">
        {
          counts.map((c) => (
            <div class="counter">
              <dt>{c.label}</dt>
              <dd>{c.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <section class="board demo-slot" aria-label="How the skill picks a method">
      <RouterDemo client:visible examples={procedures} segments={facts.count} repo={REPO} />
    </section>

    <div class="status-block">
      <div>
        <p class="status-block__label">Where the evidence stands</p>
        <p>
          <strong>We built the measuring tools first.</strong> Every result is public,
          including the times we caught our own ruler bending.
        </p>
        <p>
          No skill here carries a verdict yet. The scorecard stays empty until one
          earns it.
        </p>
      </div>
    </div>

    <h2>What goes wrong now</h2>
    <p>Give an agent a pile of facts and a question. It treats every fact as equal.</p>
    <p>
      Tell it that it is raining in Paraguay. Then ask about a trip to Lisbon. You may
      get a raincoat in the answer. The fact arrived, so the agent used it.
    </p>
    <p class="bad-answer">&ldquo;&hellip;and given the rain in Paraguay, pack a raincoat.&rdquo;</p>
    <p>
      A big choice and a small one get the same thought. That is the other half of the
      problem.
    </p>

    <h2>{facts.countWord} methods. It reads one.</h2>
    <p>It asks one question first. What is hard here? The answer picks the method.</p>

    <ol class="board procedures">
      {
        procedures.map((p) => (
          <li class="proc">
            <span class="proc__ord">{p.ord}</span>
            <h3 class="proc__name">{p.name}</h3>
            <p class="proc__when">{p.when}</p>
            <a class="proc__file" href={`${REPO}/blob/main/${p.path}`}>
              {p.md}
            </a>
          </li>
        ))
      }
    </ol>

    <p>More than one can apply. Then four of them run in order, and each feeds the next.</p>
    <p>Two is usually enough. Three means you have two choices, not one.</p>
    <p>The last two do not join that chain. Each one runs on its own.</p>
    <p>
      It also knows when to stay off. A lookup is not a choice, and neither is a bug hunt.
    </p>

    <h2 id="install">Install it in one line</h2>
    <p>
      The files are plain markdown, so you can read them yourself. They follow the
      <a href="https://agentskills.io">Agent Skills</a> standard. You copy them and they
      work.
    </p>

    <h3>Claude Code</h3>
    <div class="code"><pre><code>cp -r skills/* .claude/skills/</code></pre></div>

    <h3>Codex, Cursor, Copilot, Gemini CLI, Cline, Amp, OpenCode</h3>
    <div class="code"><pre><code>cp -r .agents/skills/* ~/.agents/skills/</code></pre></div>

    <p class="muted">
      There is also a Claude Code plugin. It ships nothing today. A skill goes in only
      after it passes a test.
    </p>

    <div class="caveat">
      <p class="caveat__label">Before you install it</p>
      <p>We have not shown this helps yet. It is free, and one line takes it back out.</p>
    </div>

    <h2>What we found</h2>
    <p>
      We have made {shown('total-model-calls')} model calls. Every one asks the same
      thing. Does the skill turn on at the right time? Not one of them asks yet whether it
      helps you choose better.
    </p>

    <figure class="board plot">
      <figcaption>
        <span class="plot__title">Does the skill turn on when it should?</span>
        <span class="plot__sub">
          Firing accuracy by how the skill describes itself. 258 questions, haiku.
        </span>
      </figcaption>

      <div class="plot__rows">
        {
          arms.map((a) => (
            <div class="plot__row" data-best={a.accuracy === best ? '' : undefined}>
              <span class="plot__arm">{a.arm}</span>
              <span class="plot__track">
                <span class="plot__bar" style={`width:${place(a.accuracy)}%`} />
                <span class="plot__dot" style={`left:${place(a.accuracy)}%`} />
              </span>
              <b class="plot__val">{a.accuracy.toFixed(4)}</b>
            </div>
          ))
        }
      </div>

      <div class="plot__axis">
        <span>{floor.toFixed(2)}</span>
        <span>1.00</span>
      </div>

      <p class="plot__source">
        Read from <a
          href={`${base}/results/decision-making/2026-08-19-d52236a-n7-remaining-arms/`}
          >the run record</a
        >, not typed in.
      </p>
    </figure>

    <p>
      We changed how the skill describes itself, over and over. Not one change made it
      better at spotting a real choice. Each one only traded one kind of mistake for
      another.
    </p>

    <div class="caveat">
      <p class="caveat__label">Then we checked the test set itself</p>
      <p>
        <strong>
          You could pass {shown('corpus-solvability')} of the old one by counting words.
        </strong>
        Long message, real choice. Short message, not a choice. A word count gets you
        that far on its own.
      </p>
      <p>
        So every result on that set was a fight over about {shown('headroom-points')}. That
        makes our own work look worse. We found it, we wrote it down, and we built a new
        set. On the new one the word trick gets {shown('word-trick-ceiling')}.
      </p>
    </div>

    <p>
      A verdict rules what we may claim in public. It does not rule what you may
      install. Use it if it helps you. Drop it if it does not.
    </p>
    <p>
      We also keep a list of the times we broke our own tests. {
        shown('broken-measurements')
      } so far. Every one ran clean and handed back a number that looked fine. Nothing
      crashed. That is why we keep looking.
    </p>

    <div class="cta">
      <a class="cta__secondary" href={`${base}/docs/status/`}>Read every result</a>
      <a class="cta__secondary" href={`${base}/notebook/`}>Read the research log</a>
      <a class="cta__secondary" href={`${base}/docs/limitations/`}>
        Read what is wrong with this
      </a>
    </div>

    <h2>How we test</h2>
    <p>
      Lots of people share prompt packs. Almost nobody checks if they work. A
      confirmation run puts a skill through four versions on the same questions.
    </p>

    <div class="table-scroll breakout">
      <table>
        <thead>
          <tr><th>Version</th><th>What it gets</th><th>What it tells us</th></tr>
        </thead>
        <tbody>
          {
            testArms.map(([v, run, tells]) => (
              <tr>
                <td>
                  <code>{v}</code>
                </td>
                <td>{run}</td>
                <td>{tells}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p>
      A placebo is a fake with the same shape. Beating no skill at all is easy. The
      placebo is the one that tells us anything. If filler scores the same, the words did
      nothing.
    </p>
    <p>
      The placebo is written, and a check here refuses one of the wrong size or shape. No
      run has used it yet, or the step-by-step one.
    </p>
    <p>
      We write down what we expect before each run. The date goes into git history, so we
      cannot move it later. A guess made after the fact is not a guess.
    </p>
    <p>
      We do not write the answer key either. Three copies of the model label the test set
      blind. None of them sees our label, or the other two. We set one rule before we ran
      it. If too many labels move, we throw the test set out.
    </p>
    <p>
      <a href={`${base}/docs/methods/`}>How we test, in full.</a> Every method, what it
      guards against, and whether we have actually run it. Some we have not.
    </p>

    <h2>Who this is for</h2>
    <ul>
      <li>You use an AI agent and face real choices.</li>
      <li>You write agent skills and want to know if yours works.</li>
      <li>You study these tools and want the raw data.</li>
    </ul>

    <h3>Who it is not for</h3>
    <ul>
      <li>You want a badge that says this works. There is no badge yet.</li>
      <li>You want a lookup or a bug fix. It stays off for those.</li>
    </ul>
  </div>
</Base>

<style>
  /* Sits on the board track, not the prose measure: two columns, with the
     counts list in the right-hand one. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: start;
    padding: var(--space-4xl) 0 var(--space-2xl);
  }

  .hero .lede {
    max-width: 34rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0 0 var(--space-lg);
    font: 500 .75rem/1 var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.25rem);
    line-height: .98;
    letter-spacing: -.042em;
    font-weight: 640;
  }

  .hero__title span {
    color: var(--ink-muted);
  }

  .hero .lede {
    margin-top: var(--space-lg);
  }

  .hero__counts {
    margin: 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--rule);
  }

  .hero__counts .counter {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .hero__counts .counter:last-child {
    border-bottom: 0;
  }

  .hero__counts dt {
    font-size: .8125rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .hero__counts dd {
    margin: 0;
    flex: none;
    font: 560 1.375rem/1 var(--font-mono);
    letter-spacing: -.02em;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink-strong);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-xl) 0 0;
  }

  .cta a {
    font: 500 .875rem/1 var(--font-mono);
    text-decoration: none;
    padding: .7rem 1.1rem;
    border-radius: var(--radius-2);
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }

  .cta__primary {
    background: var(--signal);
    color: var(--signal-on);
    border: 1px solid var(--signal);
  }

  .cta__primary:hover {
    background: var(--signal-hover);
    border-color: var(--signal-hover);
  }

  .cta__secondary {
    color: var(--ink-secondary);
    border: 1px solid var(--rule);
  }

  .cta__secondary:hover {
    color: var(--ink-strong);
    border-color: var(--rule-interactive);
  }

  .demo-slot {
    margin-block: var(--space-xl) var(--space-2xl);
  }

  .bad-answer {
    font-family: var(--font-mono);
    font-size: .8125rem;
    line-height: 1.7;
    color: var(--ink-muted);
    padding: var(--space-sm) var(--space-md);
    border-left: 2px solid var(--v-harmful-rule);
    background: var(--v-harmful-wash);
    border-radius: 0 var(--radius-2) var(--radius-2) 0;
  }

  .procedures {
    list-style: none;
    margin: var(--space-xl) 0 var(--space-2xl);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule-hair);
    border: 1px solid var(--rule-hair);
    border-radius: var(--radius-3);
    overflow: hidden;
  }

  .proc {
    margin: 0;
    padding: var(--space-lg);
    background: var(--ground);
    transition: background var(--dur-1) var(--ease);
  }

  .proc:hover {
    background: var(--raised);
  }

  .proc__ord {
    font: 500 .6875rem/1 var(--font-mono);
    letter-spacing: .12em;
    color: var(--ink-muted);
  }

  .proc__name {
    margin: var(--space-xs) 0 var(--space-2xs);
    font-size: 1.0625rem;
  }

  .proc__when {
    margin: 0 0 var(--space-sm);
    font-size: .875rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .proc__file {
    font: 500 .75rem/1 var(--font-mono);
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .proc__file:hover {
    color: var(--signal);
    border-bottom-color: var(--signal-rule);
  }

  .plot {
    margin: var(--space-xl) 0 var(--space-2xl);
    padding: var(--space-lg);
    border: 1px solid var(--rule);
    border-radius: var(--radius-3);
    background: var(--raised);
  }

  .plot figcaption {
    margin-bottom: var(--space-lg);
  }

  .plot__title {
    display: block;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ink-strong);
    letter-spacing: -.02em;
  }

  .plot__sub {
    display: block;
    margin-top: var(--space-3xs);
    font: 400 .75rem/1.5 var(--font-mono);
    color: var(--ink-muted);
  }

  .plot__row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) 4rem;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-2xs) 0;
  }

  .plot__arm {
    font: 400 .8125rem/1.4 var(--font-mono);
    color: var(--ink-secondary);
    overflow-wrap: anywhere;
  }

  .plot__track {
    position: relative;
    height: .75rem;
    border-left: 1px solid var(--rule-strong);
  }

  /* Bars are drawn on entry; the animation is decorative and lives in the
     prefers-reduced-motion: no-preference block at the end of this file. */
  .plot__bar {
    position: absolute;
    top: 50%;
    left: 0;
    height: 1px;
    background: var(--rule-strong);
    transform: translateY(-50%);
  }

  .plot__dot {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    background: var(--ink-muted);
    transform: translateY(-50%);
  }

  .plot__row[data-best] .plot__dot {
    background: var(--signal);
  }

  .plot__row[data-best] .plot__arm,
  .plot__row[data-best] .plot__val {
    color: var(--ink-strong);
  }

  .plot__val {
    font: 500 .8125rem/1 var(--font-mono);
    font-variant-numeric: tabular-nums lining-nums;
    text-align: right;
    color: var(--ink-secondary);
  }

  .plot__axis {
    display: flex;
    justify-content: space-between;
    margin: var(--space-2xs) 4.5rem 0 9.5rem;
    font: 400 .6875rem/1 var(--font-mono);
    color: var(--ink-muted);
  }

  .plot__source {
    margin: var(--space-md) 0 0;
    font: 400 .75rem/1.5 var(--font-mono);
    color: var(--ink-muted);
  }

  /* Decorative only: the scroll-driven draw-in for .plot__bar, guarded so it
     never runs for readers who ask for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .plot__bar {
      animation: draw var(--dur-3) var(--ease) both;
      animation-timeline: view();
      animation-range: entry 0% cover 30%;
    }

    @keyframes draw {
      0% {
        transform: translateY(-50%) scaleX(0);
        transform-origin: left;
      }
    }
  }

  /* Hero drops to one column: the counts move below the prose. */
  @media (max-width: 68rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  /* Procedure grid goes from three columns to two. */
  @media (max-width: 62rem) {
    .procedures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Single column throughout: procedures collapse to one, the hero's top padding
     drops to --space-2xl, and the plot's label and value columns narrow. */
  @media (max-width: 40rem) {
    .hero {
      padding-top: var(--space-2xl);
    }

    .procedures {
      grid-template-columns: minmax(0, 1fr);
