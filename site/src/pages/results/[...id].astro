---
import { getCollection, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { titleFrom, stripReadme, sourcePath } from '../../lib/titles.ts';

export async function getStaticPaths() {
  const entries = await getCollection('results');
  return entries.map((entry) => ({
    params: { id: stripReadme(entry.id).replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Doc
  title={titleFrom(headings, entry.id)}
  source={sourcePath(entry.filePath, `results/${entry.id}.md`)}
  kind="published run record"
  body={(entry as typeof entry & { body?: string }).body}
  id={entry.id}
>
  <Content />
</Doc>
