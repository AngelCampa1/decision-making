---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { titleFrom, stripReadme } from '../../lib/titles.ts';
import { shown } from '../../lib/claims.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getCollection('results');

const runs = await Promise.all(
  entries.map(async (entry) => {
    const slug = stripReadme(entry.id).replace(/\/$/, '');
    const { headings } = await render(entry);
    const dir = slug.split('/').pop() ?? slug;
    return { slug, dir, title: titleFrom(headings, entry.id) };
  }),
);

runs.sort((a, b) => (a.dir < b.dir ? 1 : -1));
---

<Base title="Published runs &middot; decision-making-skills">
  <div class="page index-page">
    <h1>Published runs</h1>
    <p class="lede">
      One directory per run, with its raw transcripts and a record of what it showed.
      Every one names the answer-key version it used and the prediction that predates it.
    </p>

    <div class="caveat">
      <p class="caveat__label">Read these with the corpus caveat</p>
      <p>
        Every trigger result published before 2026-08-18 was measured on a set a word
        count passes {shown('corpus-solvability')} of the time, so those results were
        competing for about {shown('headroom-points')} over a ruler. The results are real;
        the room they had was small.
      </p>
      <p>
        It does not apply to every run below. The corpus was rebuilt, and on the new one
        the best model-free shortcut reaches {shown('word-trick-ceiling')}. Each run names
        the answer-key version it used.
      </p>
    </div>

    {/* "written up here", not "published runs". `docs/RUN_INDEX.md` is
        generated and lists thirteen; this collection globs `*​/*​/README.md` and
        sees twelve, because the baselined `evidence-ledger/2026-08-10-baseline-corpus`
        has data and no write-up. Both counts are honest about different sets --
        but stating a smaller number under the generated index's own phrase is
        the cross-document disagreement this site exists to stop making. */}
    <p class="index-count">
      {runs.length} runs written up here &middot; <a href={`${base}/docs/run-index/`}
        >the full index lists every run</a
      >
    </p>

    <ul class="run-list">
      {
        runs.map((run) => (
          <li class="run-item">
            <a href={`${base}/results/${run.slug}/`}>
              <span class="run-item__dir">{run.dir}</span>
              <span class="run-item__title">{run.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .index-page {
    padding-top: var(--space-2xl);
  }

  .index-count {
    font: 400 0.8125rem/1.6 var(--font-mono);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums lining-nums;
    margin-top: var(--space-2xl);
  }

  .run-list {
    list-style: none;
    padding: 0;
    margin: var(--space-xs) 0 0;
    border-top: 1px solid var(--rule-strong);
  }

  .run-item {
    margin: 0;
    border-bottom: 1px solid var(--rule-hair);
  }

  .run-item a {
    display: block;
    padding: var(--space-sm) 0;
    text-decoration: none;
  }

  .run-item__dir {
    display: block;
    font: 500 0.8125rem/1.5 var(--font-mono);
    color: var(--ink-strong);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .run-item a:hover .run-item__dir {
    color: var(--signal);
  }

  .run-item__title {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink-secondary);
  }

  .run-item a:hover .run-item__title {
    color: var(--ink);
  }
</style>
