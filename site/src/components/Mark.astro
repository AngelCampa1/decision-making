---
/**
 * One row of a forest plot -- the actual Cochrane notation, not a metaphor for
 * it. A vertical line of no effect, a horizontal confidence interval with
 * T-caps, and a square point estimate.
 *
 * The default geometry encodes this repository's real position, which is more
 * specific than "null": the estimate is clearly positive and the lower bound
 * dips below zero. That is "we have not shown this works" stated
 * geometrically, rather than "this does not work" -- the distinction
 * SCORECARD.md exists to make.
 *
 * The interval is exactly symmetric about the estimate (27 units each side),
 * so it is a legitimate interval and survives anyone who checks. That matters
 * here more than it would elsewhere.
 */
interface Props {
  state?: 'null' | 'provisional' | 'ship' | 'harmful' | 'untested';
  width?: number;
  class?: string;
  title?: string;
}

const { state, width = 64, class: className = '', title } = Astro.props;
const height = width / 2;
---

<svg
  class={`mark ${className}`}
  data-state={state}
  viewBox="0 0 64 32"
  width={width}
  height={height}
  fill="none"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <line
    x1="16" y1="2" x2="16" y2="30"
    stroke="var(--mark-axis)" stroke-width="var(--mark-w-axis)"
  />
  <line
    x1="5" y1="16" x2="59" y2="16"
    stroke="var(--mark-ink)" stroke-width="var(--mark-w-data)"
  />
  <line
    x1="5" y1="8" x2="5" y2="24"
    stroke="var(--mark-ink)" stroke-width="var(--mark-w-data)"
  />
  <line
    x1="59" y1="8" x2="59" y2="24"
    stroke="var(--mark-ink)" stroke-width="var(--mark-w-data)"
  />
  <rect class="mark__estimate" x="27" y="11" width="10" height="10" fill="var(--mark-accent)" />
</svg>
