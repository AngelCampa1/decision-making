---
/**
 * The mark: a ring of segments with exactly one lit.
 *
 * It is the skill's claim drawn rather than described — six procedures, and it
 * reads one. The segment count is not a constant; it comes from the routing
 * table in `skills/decision-making/SKILL.md` by way of `src/lib/facts.ts`, so a
 * seventh procedure redraws the logo. A mark that cannot go out of date with
 * the product is worth more than a prettier one that can.
 *
 * `state` recolours the lit segment from the verdict vocabulary. The default,
 * `untested`, is grey and dashed: an absence of a result, not a bad one.
 */
import { VERDICT_STATES, type VerdictState } from '../lib/verdicts.ts';

interface Props {
  state?: VerdictState;
  /** How many segments the ring has. Pass `facts.count`; never hardcode it at a call site. */
  segments?: number;
  /** Index of the lit segment, 0-based. */
  lit?: number;
  width?: number;
  class?: string;
  title?: string;
}

const {
  state = 'untested',
  segments = 6,
  lit = 0,
  width = 40,
  class: className = '',
  title,
} = Astro.props;

if (!VERDICT_STATES.includes(state)) {
  throw new Error(
    `Mark: unknown verdict state \`${state}\`. The vocabulary is defined in ` +
      'SCORECARD.md and mirrored in src/lib/verdicts.ts.',
  );
}

// Geometry. The ring is inscribed in a 64-unit box with a 5-unit stroke, so the
// radius leaves half the stroke inside the viewBox on every side.
const R = 26;
const STROKE = 5;
const CIRCUMFERENCE = 2 * Math.PI * R;

// A gap proportional to the arc, so the ring reads the same at six segments as
// at nine. 22% of each arc is the largest gap that still reads as a ring rather
// than as loose ticks.
const arc = CIRCUMFERENCE / segments;
const drawn = arc * 0.78;

const ring = Array.from({ length: segments }, (_, i) => ({
  index: i,
  dasharray: `${drawn.toFixed(3)} ${(CIRCUMFERENCE - drawn).toFixed(3)}`,
  dashoffset: (-i * arc).toFixed(3),
}));
---

<svg
  class={`mark ${className}`.trim()}
  data-state={state}
  data-segments={segments}
  data-lit={lit}
  viewBox="0 0 64 64"
  width={width}
  height={width}
  fill="none"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <g transform="rotate(-90 32 32)" stroke-width={STROKE} stroke-linecap="butt">
    {
      ring.map((segment) => (
        <circle
          class={segment.index === lit ? 'mark__lit' : 'mark__track'}
          data-index={segment.index}
          cx="32"
          cy="32"
          r={R}
          stroke-dasharray={segment.dasharray}
          stroke-dashoffset={segment.dashoffset}
        />
      ))
    }
  </g>
</svg>
