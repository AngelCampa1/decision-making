---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/base.css';
import Mark from '../components/Mark.astro';
import { REPO, NAV } from '../lib/site.ts';
import { skillFacts } from '../lib/facts.ts';
import { verdictState } from '../lib/verdicts.ts';

interface Props {
  title: string;
  /** The sentence a search engine prints under the link. Required, see below. */
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  /** ISO date. Article pages only, and only where one can be derived. */
  publishedTime?: string;
  /** The JSON-LD graph for this page, built by `schema.ts`. */
  schema?: object;
}

const facts = await skillFacts();
const state = verdictState(facts.verdict);

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  publishedTime,
  schema,
} = Astro.props;

/**
 * Every page states its own description, and this throw is what makes that
 * true. It was a default parameter until 2026-08-20, and a default nobody has
 * reason to look at is how all 159 pages came to advertise themselves with one
 * sentence about the skill — the limitations page and the research log
 * included.
 *
 * A type would be the obvious guard and is not enough on its own: `astro check`
 * is not in `deploy-site.yml`, which runs `npm run build`, so `Props` is
 * advisory at deploy time and this is not.
 */
if (!description) {
  throw new Error(
    `<Base> rendered "${title}" with no description. Derive one with ` +
      '`descriptionFrom()` or write one, but do not leave this page sharing ' +
      'the description that belongs to another.',
  );
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '');

// Absolute, because a social crawler resolves nothing against the page.
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const ogImageAlt =
  'decision-making-skills. An agent skill for hard choices. Nothing proven yet.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:site_name" content="decision-making-skills" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* `set:html` does not escape, and these descriptions are derived from
        markdown that contains `<`. Escaping the sequence that could close this
        script early is the whole guard. */}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />}
    {/* Set before first paint so an explicit choice never flashes the other theme. */}
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header__inner">
        {/* `aria-label` because the visible name is not always there. Below
            32rem `.lockup__word` is display:none and the mark is decorative
            (`aria-hidden`), which left the home link of every page with no
            accessible name at all on a phone -- announced as just "link". */}
        <a class="lockup" href={`${base}/`} aria-label="decision-making-skills, home">
          <Mark width={30} segments={facts.count} state={state} />
          <span class="lockup__word">decision-making-skills</span>
        </a>

        <nav class="site-nav" aria-label="Main">
          {
            NAV.map((item) => (
              <a
                href={item.href.startsWith('http') ? item.href : `${base}${item.href}`}
                class={item.wide ? 'site-nav__wide' : undefined}
                aria-current={path === `${base}${item.href}`.replace(/\/$/, '') ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        {/* `hidden` until the script that gives these buttons behaviour has
            run. Server-rendered, they were three focusable controls announced
            as a labelled group, none of them marked pressed and none of them
            doing anything -- the page reads the system theme correctly without
            them, so with no JavaScript the honest thing is not to offer the
            choice. The copy buttons alongside already work this way: they are
            created by the script rather than shipped inert. */}
        <div class="theme-toggle" role="group" aria-label="Colour theme" hidden>
          <button type="button" data-theme-set="system">sys</button>
          <button type="button" data-theme-set="light">light</button>
          <button type="button" data-theme-set="dark">dark</button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="page">
        <div class="breakout site-footer__grid">
          <div>
            <p class="site-footer__honest">
              We have not proven anything here yet. That is a status, not a sales
              pitch. Use it if it helps you.
            </p>
          </div>
          <ul class="site-footer__links">
            <li><a href={`${base}/docs/status/`}>Results</a></li>
            <li><a href={`${base}/scorecard/`}>Scorecard</a></li>
            <li><a href={`${base}/notebook/`}>Research log</a></li>
            <li><a href={`${base}/docs/limitations/`}>Limitations</a></li>
            <li><a href={REPO}>GitHub</a></li>
          </ul>
          <p class="site-footer__stamp">
            {/* Read from the skill's own frontmatter, so this line cannot
                outlive a promotion the way a typed-in count would. */}
            <span>Apache-2.0 &middot; Angel Campa</span>
            <span>decision-making v{facts.version}</span>
            <span class="verdict" data-verdict={state}>{facts.verdict}</span>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var toggle = document.querySelector('.theme-toggle');
        if (toggle) toggle.hidden = false;
        function paint() {
          var t = localStorage.getItem('theme') || 'system';
          document.querySelectorAll('[data-theme-set]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.themeSet === t));
          });
        }
        document.querySelectorAll('[data-theme-set]').forEach(function (b) {
          b.addEventListener('click', function () {
            var next = b.dataset.themeSet;
            if (next === 'system') {
              localStorage.removeItem('theme');
              delete root.dataset.theme;
            } else {
              localStorage.setItem('theme', next);
              root.dataset.theme = next;
            }
            paint();
          });
        });
        paint();

        // Copy buttons. The label swap is announced, not just shown.
        document.querySelectorAll('.code').forEach(function (block) {
          var pre = block.querySelector('pre');
          if (!pre) return;
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code__copy';
          btn.textContent = 'copy';
          btn.addEventListener('click', function () {
            navigator.clipboard.writeText(pre.innerText).then(function () {
              btn.textContent = 'copied';
              btn.dataset.copied = '';
              setTimeout(function () {
                btn.textContent = 'copy';
                delete btn.dataset.copied;
              }, 1600);
            });
          });
          block.appendChild(btn);
        });
      })();
    </script>
  </body>
</html>
