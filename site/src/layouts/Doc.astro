---
import Base from './Base.astro';
import Mermaid from '../components/Mermaid.astro';
import { REPO, SITE_DESCRIPTION } from '../lib/site.ts';
import { descriptionFrom } from '../lib/descriptions.ts';
import {
  breadcrumbNode,
  dateFromId,
  documentNode,
  graph,
  kindMeta,
  personNode,
  websiteNode,
} from '../lib/schema.ts';

interface Props {
  title: string;
  /** Repository-relative path, e.g. `docs/STATUS.md`. Shown as provenance. */
  source: string;
  /** Short label for where this sits: "documentation", "notebook", ... */
  kind: string;
  description?: string;
  /** Raw markdown. The description is derived from it; these files carry no frontmatter. */
  body?: string;
  /** Collection id, the only place a publication date can honestly come from. */
  id?: string;
}

const { title, source, kind, description, body, id } = Astro.props;

/* Every rendered document gets its metadata here rather than in the five page
   templates, so there is one implementation and not five that drift. */
const meta = kindMeta(kind);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteRoot = new URL(`${base}/`, Astro.site).href;
const resolved = description ?? descriptionFrom(body, `${title}. ${SITE_DESCRIPTION}`);
const published = id ? dateFromId(id) : undefined;

const schema = graph([
  personNode(siteRoot),
  websiteNode(siteRoot, SITE_DESCRIPTION),
  documentNode({
    canonical,
    siteRoot,
    title,
    description: resolved,
    meta,
    sourcePath: source,
    datePublished: published,
  }),
  breadcrumbNode({ canonical, siteRoot, title, section: meta.section }),
]);
---

{/* `ogTitle` drops the suffix: `og:site_name` already carries it, and a social
    card that spends its headline saying the site name twice has wasted it. */}
<Base
  title={`${title} · decision-making-skills`}
  description={resolved}
  ogTitle={title}
  ogDescription={resolved}
  ogType={meta.ogType}
  publishedTime={published}
  schema={schema}
>
  <article class="page doc">
    <p class="doc__eyebrow">
      <span>{kind}</span>
      <a href={`${REPO}/blob/main/${source}`}><code>{source}</code></a>
    </p>
    <div class="doc__body">
      <slot />
    </div>
  </article>
  {/* Ships on every rendered page and loads nothing on a page without a
      diagram: the mermaid import sits behind a `querySelector` check. */}
  <Mermaid />
</Base>

{/* Styles for the rendered markdown itself live in base.css, next to the grid
    placement rules they depend on -- they are global by nature, and a scoped
    component block is the wrong home for them. */}

<style>
  .doc {
    padding-top: var(--space-2xl);
  }

  .doc__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-sm);
    font: 400 0.75rem/1.6 var(--font-mono);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-md);
  }

  .doc__eyebrow span::after {
    content: " \00B7";
    color: var(--ink-muted);
  }

  .doc__eyebrow a {
    color: var(--ink-muted);
    text-decoration: none;
    text-transform: none;
    letter-spacing: 0;
  }

  .doc__eyebrow a:hover {
    color: var(--accent);
  }

  .doc__eyebrow code {
    background: none;
    padding: 0;
    font-size: 1em;
  }

  /* The rendered document is a grid child so its tables can break out. */
  .doc__body {
    display: contents;
  }
</style>
