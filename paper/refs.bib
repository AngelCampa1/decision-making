  journal = {arXiv preprint arXiv:2606.29718},
  year   = {2026},
  quote  = {By controlling for query difficulty, we show that the premature
            termination rate is positively correlated with context length.},
  note   = {Verified first-hand 2026-08-12, and THE 30-50\% FIGURE IS NOT IN
            THIS PAPER. Three documents here cited it for "context rot is
            documented at 30-50\% in long-horizon settings"; it is not in the
            abstract, was not found in the PDF, and does not appear in any
            secondary summary. What the paper establishes is a MECHANISM --
            premature termination, models giving up or answering uncertainly
            long before the window is full, at a rate rising with context
            length -- across four flagship models and three benchmarks
            (BrowseComp, BrowseComp-Plus, xbench-DeepSearch). Its own headline
            number is a GAIN of 2.6-4.9\% from behaviour-aware filtering. Cite
            the mechanism; do not attach a magnitude to it from here}
}

