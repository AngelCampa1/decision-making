@article{ninejudges2026,
  author = {Kohli, Guneet},
  title  = {Nine Judges, Two Effective Votes: Correlated Errors Undermine
            {LLM} Evaluation Panels},
  journal = {arXiv preprint arXiv:2605.29800},
  year   = {2026},
  quote  = {Testing a panel of 9 frontier LLMs from 7 model families on three
            natural language inference datasets (each with 100 human annotations
            per item), we find that the 9 judges effectively provide only about
            2 independent votes' worth of information. ... The consequences are
            stark: the panel's actual accuracy falls 8-22 percentage points
            short of what independent voting would achieve, and the best single
            judge matches or outperforms the full panel across all conditions.},
  note   = {Verified first-hand 2026-08-13, and TWO OF THE THREE FIGURES WE
            CARRY ARE NOT IN THE ABSTRACT. (1) "22pp predicted under
            independence" IS THE TOP OF A RANGE REPORTED AS A POINT VALUE: the
            paper says the shortfall is 8-22 percentage points. Quoting 22
            alone reports the most favourable end of the authors' own interval,
            which is the same defect this repository has already recorded
            against a registered band that named a number without its
            estimator. (2) "Panel lift over the best single judge +0.2pp" points
            the OPPOSITE WAY to the abstract, which says the best single judge
            "matches or outperforms the full panel across all conditions" -- a
            positive lift for the panel is not that claim. (3) n_eff = 2.18 and
            the 95\% CI [2.07, 2.31], and the mean pairwise correlation 0.391 in
            docs/RELATED_WORK.md 260-261 (LINE NUMBERS CORRECTED 2026-08-14,
            was 191-193), are not in the abstract; "about 2 independent votes'
            worth" is. They may all be in the body and this
            entry does not assert they are absent -- it asserts they are
            UNVERIFIED, which is a different and weaker claim, and the fix is to
            read the tables rather than to keep quoting them. AND THE WORST OF
            IT IS THE AXIS, which an independent check found and this note
            originally missed: "+0.2pp against a predicted-under-independence
            22pp" reads the two as observed-lift versus predicted-lift, and they
            are not the same quantity. The 22pp is an ACCURACY SHORTFALL against
            the Condorcet independent-voting ideal; the +0.2pp is a LIFT OVER
            THE BEST SINGLE JUDGE. Putting them on one axis is the same class of
            error as scoring two arms off different objects. That check also
            reports every body figure we quote is MNLI-ONLY (SNLI is n_eff 2.35,
            and there the best judge beats the panel outright), so +0.2pp is the
            one dataset where the panel edges ahead in a paper whose headline is
            that it does not. Neither the body reading nor the per-dataset
            figures are confirmed first-hand here. THE DESIGN
            CONCLUSION SURVIVES INTACT and is if anything understated: the
            structural ceiling is the paper's headline, "the bottleneck is
            correlated judges, not the aggregation algorithm" is verbatim, and
            capping the council at three divergent judges follows from it}
}

