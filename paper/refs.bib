  journal = {arXiv preprint arXiv:2605.31408},
  year   = {2026},
  quote  = {Relative to no skill, skill conditions increase task-mean pass
            rate by 26.7 to 36.0 percentage points for GPT-5.5 and by 18.0 to
            26.0 percentage points for DeepSeek V4-Flash.},
  note   = {Verified first-hand 2026-08-12. SCALE CORRECTED: a 30-task
            domain-balanced SkillsBench subset, 2 models, 6 skill conditions,
            5 trials, 1800 rows. Earlier entries here and in RELATED_WORK said
            "86 tasks, 11 domains", which is neither this paper's scale nor
            SkillsBench's own (87 tasks, 8 domains) -- it conflated the two, in
            the direction that made this paper look larger. The +18 to +36pp
            range quoted in CLAUDE.md and AGENTS.md is the union of the two
            models' ranges and is correct. Granularity +0.7pp (GPT-5.5),
            -6.7pp (DeepSeek), CIs crossing zero; the -6.7 is the larger
            figure and should travel with the +0.7 whenever both are summarised}
