# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.json
htmlcov/

# Run logs are large; the curated ones live under results/ and are committed
# deliberately by `de confirm`, never picked up incidentally. (`*.eval` is the
# Inspect AI log extension, kept as a belt-and-braces entry even though the
# inspect-ai dependency has been removed -- an ignore rule for a file we no
# longer produce costs nothing, and an untracked 100MB log costs a lot.)
logs/
*.eval

# The private holdout is regenerated from a passphrase-derived seed, never committed
# until after a verdict publishes. See datasets/holdout/README.md.
datasets/holdout/*.jsonl
.holdout-passphrase

# Local scratch
scratch/
*.local.json

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/main.pdf

# OS
Thumbs.db
.DS_Store

# Live run checkpoints. These are append-only working files that a run writes
# while it executes, so committing one mid-run is both meaningless and, on
# Windows, impossible while the writer holds it.
#
# Reported runs are published deliberately as results/<skill>/<date>-<sha7>/
# once complete, transcripts included. The calibration checkpoint is a
# pre-registration gate rather than a reported result; its outcome is recorded
# in notebook/.
results/calibration/

# Vendored third-party corpora: pinned by hash in *.lock.json, fetched by `de fetch`.
# The payloads are large and byte-identical upstream, so the lock is committed and
# the data is not.
datasets/vendor/*.json
!datasets/vendor/*.lock.json

# Live Track A checkpoints. Same reason as results/calibration/: an append-only
# working file cannot be meaningfully committed mid-run, and on Windows cannot be
# committed at all while the writer holds it. Completed runs are published
# deliberately.
results/track-a/

# Track 0 instrument checkpoints. Complete runs, but re-running appends, and
# the durable record of what they showed lives in notebook/ as it does for
# results/calibration/.
results/track-0/

# Live trigger checkpoint. Resumable and appended to on every re-run, so the
# same reasons as results/calibration/ apply. Completed runs are published as
# results/<skill>/<date>-<sha7>/ with the numbers they produced.
results/triggers/
